# Test environment variables
# Copy this file to .env.test and fill in your values.
# NEVER commit .env.test — it contains secrets.

# Neon Auth (Better Auth) base URL of the branch under test (AUTH-2 #950).
# Same shape as apps/web/.env VITE_NEON_AUTH_BASE_URL:
# https://<branch>.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=

# QA test user (provisioned per branch — docs/ops/auth-migration-neon.md §4).
# Path A (password sign-in) is what the E2E live-login spec and local-login
# script use; no email inbox is needed.
QA_NEON_USER_EMAIL=qa-bot@animichi.test
QA_NEON_USER_PASSWORD=

# Site URL for browser QA
QA_SITE_URL=https://seichijunrei.zhenjia.org
