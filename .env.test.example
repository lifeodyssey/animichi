# Test environment variables
# Copy this file to `.env.test` and fill in your values.
# NEVER commit .env.test — it contains secrets.
#
# `.env.test` lives at the REPO ROOT, and the live login lane is what reads it:
# `pnpm --filter animichi-e2e run test:login` runs node with
# `--env-file-if-exists=../.env.test` (#1813). It is optional — the flag is
# `if-exists`, so a machine without this file behaves exactly as it did before,
# and no CI run reads it. Nothing else in the repository loads it.


# Neon Auth (Better Auth) base URL of the branch under test (AUTH-2 #950).
# Same shape as apps/web/.env VITE_NEON_AUTH_BASE_URL:
# https://<branch>.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=

# QA test user (provisioned per branch — docs/ops/auth-migration-neon.md §4).
# Path A (password sign-in) is what the E2E live-login spec and local-login
# script use; no email inbox is needed.
QA_NEON_USER_EMAIL=qa-bot@animichi.test
QA_NEON_USER_PASSWORD=

# Site URL for browser QA. Read by NOTHING in this repository — no script, spec
# or lane loads this name (#1813 measured the rest of this file's readers), so
# treat it as an operator note; give it a reader or drop it, but do not assume it
# reaches a browser.
QA_SITE_URL=https://seichijunrei.zhenjia.org
