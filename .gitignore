backend/tests/eval/results/agent_openai-mimo-*
*.tsbuildinfo

# Failure-attribution evidence (E-4 #1383): the visitor's query, the reply and
# the tool returns behind each attributed case. `packages/eval/results/` is
# committed because nothing in it is a secret; this is the other half, and it
# goes to an access-controlled CI artifact instead. The DIRECTORY is ignored, so
# a future artifact kind cannot land in a commit by being new.
packages/eval/artifacts/

# Catalog TS service source — re-include (root lib/ rule is too broad)
!catalog/src/lib/
!workers/catalog/src/lib/
!workers/catalog/src/lib/**

# Users TS service source — re-include (root lib/ rule is too broad)
!workers/users/src/lib/
!workers/users/src/lib/**

# apps/web TS source — re-include (root lib/ rule is too broad)
!apps/web/src/lib/
!apps/web/src/lib/**

# apps/web unit tests live in tests/unit/lib/** — re-include so the versioned
# runtime-config test suite is tracked (root lib/ rule is too broad; #1013).
!apps/web/tests/unit/lib/
!apps/web/tests/unit/lib/**

# Pinned Atlas CLI self-heal cache (#730) — downloaded, checksum-verified
# binary for `make test-integration`; never checked in, never the global install.
/.cache/atlas/

# tool-generated local state (rebuildable)
.codegraph/
test-results/
.context/
.grok/
.local/

# B8 PR-comment-debt scratch (round-2 re-evidence fetches; regenerable)
/.tmp-b8/

# Command Code workspace settings (tool-local, never shared)
.commandcode/
