{
  "name": "@animichi/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-independent agent domain rules and data consumed by the edge host.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./models": "./src/models.ts",
    "./harness": "./src/harness.ts",
    "./selection": "./src/selection.ts",
    "./selection-entry": "./src/selection-entry.ts",
    "./execution-witness": "./src/execution-witness.ts"
  },
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "mkdir -p coverage && cd ../.. && node --expose-gc --import tsx --test --experimental-test-coverage --test-coverage-include='packages/agent/src/**/*.ts' --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=95 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=packages/agent/coverage/lcov.info \"packages/agent/test/*.test.ts\"",
    "test:integration": "tsc --noEmit -p integration-test/tsconfig.json && tsc --noEmit -p integration-test/worker/tsconfig.json && node --import tsx --test --test-concurrency=1 \"integration-test/*.test.ts\""
  },
  "dependencies": {
    "@animichi/contract": "workspace:*",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@orpc/client": "1.14.10",
    "@orpc/contract": "1.14.10",
    "@orpc/openapi-client": "1.14.10",
    "htmlparser2": "12.0.0",
    "typebox": "1.3.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@animichi/test-postgres": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@neondatabase/serverless": "1.1.0",
    "@types/node": "^26.1.1",
    "smol-toml": "1.7.1",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "^7.0.2"
  }
}
