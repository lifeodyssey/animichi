{
  "name": "@animichi/contract",
  "version": "0.1.0",
  "private": true,
  "description": "Typed oRPC contract between the Python Agent service (client) and the TS Catalog service (server). Single source of truth for cross-service types.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./models": "./src/models.ts",
    "./contract": "./src/contract.ts",
    "./constants": "./src/constants.ts",
    "./jwt": "./src/jwt.ts"
  },
  "scripts": {
    "emit:openapi": "node --import tsx scripts/emit-openapi.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/contract": "1.14.10",
    "@orpc/openapi": "1.14.10",
    "@orpc/zod": "1.14.10",
    "jose": "^6.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
