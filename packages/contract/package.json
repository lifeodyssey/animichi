{
  "name": "@animichi/contract",
  "version": "0.1.0",
  "private": true,
  "description": "Typed oRPC contract between the TS Catalog service (server) and its TS clients (the edge agent tier and apps/web). Single source of truth for cross-service types.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./identity": "./src/identity-contract.ts",
    "./identity-policy": "./src/identity-policy.ts",
    "./models": "./src/models.ts",
    "./contract": "./src/contract.ts",
    "./agent-contract": "./src/agent-contract.ts",
    "./session-history-contract": "./src/session-history-contract.ts",
    "./access-service-token": "./src/access-service-token.ts",
    "./agent-paths": "./src/agent-paths.ts",
    "./public-catalog": "./src/public-catalog.ts",
    "./agent-step-origin": "./src/agent-step-origin.ts",
    "./agent-tool-parameters": "./src/agent-tool-parameters.ts",
    "./agent-tool-schemas": "./src/agent-tool-schemas.ts",
    "./internal-binding": "./src/internal-binding.ts",
    "./constants": "./src/constants.ts",
    "./jwt": "./src/jwt.ts",
    "./oidc-github": "./src/oidc-github.ts"
  },
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --deny-warnings src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm run vet:baseline && pnpm run test:openapi-drift",
    "test:openapi-drift": "pnpm run emit:openapi && bash ../../scripts/local-gates/contract-drift.sh",
    "emit:openapi": "node --import tsx scripts/emit-openapi.ts",
    "emit:tool-schemas": "node --import tsx scripts/emit-tool-schemas.ts",
    "vet:openapi": "node --import tsx scripts/vet-openapi.ts",
    "vet:baseline": "node --import tsx scripts/vet-openapi-baseline.ts"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/zod": "1.15.0",
    "jose": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
