                    "checked_in_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "synced_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "photo_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
