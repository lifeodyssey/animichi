                  "point_ids": {
                    "type": "array",
                    "maxItems": 500,
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    }
                  },
                  "status": {
                    "enum": [
                      "draft",
                      "saved",
                      "completed"
                    ],
                    "type": "string",
                    "default": "saved"
                  }
                },
                "required": [
                  "title",
                  "point_ids"
                ]
              }
            }
          }
        },
