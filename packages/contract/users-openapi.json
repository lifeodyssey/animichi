                        "type": "string"
                      }
                    },
                    "status": {
                      "enum": [
                        "draft",
                        "saved",
                        "completed"
                      ],
                      "type": "string"
                    },
                    "saved_at": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "updated_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "point_ids",
                    "status",
                    "saved_at",
                    "updated_at"
                  ]
                }
              }
            }
