{
  "name": "@animichi/eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node-side eval package: reads the Python-exported pydantic-evals datasets with logfire/evals.",
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\" && pnpm run test:fixture-drift",
    "eval:gate": "node scripts/eval-gate.ts",
    "eval:staging": "node scripts/eval-staging.ts",
    "test:fixture-drift": "bash scripts/export-fixtures.sh && bash ../../scripts/local-gates/eval-fixture-drift.sh"
  },
  "dependencies": {
    "@animichi/contract": "workspace:*",
    "logfire": "0.22.5"
  },
  "devDependencies": {
    "edge-worker": "workspace:*"
  }
}
