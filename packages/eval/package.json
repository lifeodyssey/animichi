{
  "name": "@animichi/eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Pi harness tasks and preserved statistical oracles for Logfire evaluations.",
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:native": "node --import tsx --test \"test/native-*.test.ts\"",
    "eval:native": "node --import tsx --import ./scripts/instrument-evals.ts ./scripts/command-task.ts",
    "eval:record-captures": "node --import tsx ./scripts/record-captures.ts",
    "eval:regenerate-fixtures": "node --import tsx ./scripts/regenerate-dataset-fixtures.ts",
    "eval:prefix-selection": "node --import tsx ./scripts/replay-prefix-selection.ts"
  },
  "dependencies": {
    "@animichi/agent": "workspace:*",
    "@animichi/contract": "workspace:*",
    "@earendil-works/chord": "catalog:",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@pydantic/logfire-node": "0.18.25",
    "logfire": "0.22.9",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
