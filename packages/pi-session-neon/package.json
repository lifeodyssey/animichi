{
  "name": "@animichi/pi-session-neon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.json",
    "./migrations": "./migrations",
    "./migrations/*": "./migrations/*",
    "./types": "./src/contract.d.ts"
  },
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test:integration": "mkdir -p coverage && cd ../.. && node --test --test-isolation=none --experimental-test-coverage --test-coverage-include='packages/pi-session-neon/src/**/*.ts' --test-coverage-lines=95 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=packages/pi-session-neon/coverage/lcov.info \"packages/pi-session-neon/test/*.db.test.ts\"",
    "contract:emit": "prisma contract emit && node scripts/normalize-artifacts.ts",
    "migration:emit": "node scripts/run-migration.ts",
    "test": "node --test test/*.unit.test.ts test/contract-types.test.ts"
  },
  "dependencies": {
    "@animichi/prisma-geography": "workspace:*",
    "@earendil-works/pi-agent-core": "catalog:",
    "@prisma/orm-postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@animichi/test-postgres": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "prisma": "catalog:",
    "@prisma/cli-engine": "catalog:",
    "esbuild": "catalog:"
  }
}
