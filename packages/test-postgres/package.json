{
  "name": "@animichi/test-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Test-only Postgres data plane: the offline image, the readiness wait, the clean-database recipe, the service roles and the committed Prisma chain, shared by every database-backed suite. Never a runtime dependency.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./setup-budget": "./src/setup-budget.ts",
    "./postgres-image": "./src/postgres-image.ts",
    "./postgres-startup-wait": "./src/postgres-startup-wait.ts",
    "./setup-deadline": "./src/setup-deadline.ts"
  },
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:integration": "node --test \"test/integration/*.test.ts\""
  },
  "dependencies": {
    "pg": "catalog:",
    "testcontainers": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:"
  }
}
