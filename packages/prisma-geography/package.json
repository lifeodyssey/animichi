{
  "name": "@animichi/prisma-geography",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/geography/index.ts",
    "./codec-types": "./src/geography/codec-types.ts",
    "./operation-types": "./src/geography/operation-types.ts",
    "./column-types": "./src/geography/column-types.ts",
    "./control": "./src/geography/control.ts",
    "./runtime": "./src/geography/runtime.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "contract:emit": "prisma contract emit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "test": "mkdir -p coverage && cd ../.. && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='packages/prisma-geography/src/geography/**/*.ts' --test-coverage-lines=95 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=packages/prisma-geography/coverage/lcov.info 'packages/prisma-geography/test/*.unit.test.ts'",
    "test:integration": "node --test --test-concurrency=1 --test-isolation=none --test-timeout=600000 --test-reporter=spec --test-reporter-destination=stdout 'test/*.db.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/orm-postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@animichi/test-postgres": "workspace:*",
    "@prisma/cli-engine": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:"
  }
}
