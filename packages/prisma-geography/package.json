{
  "name": "@animichi/prisma-geography",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/geography/index.ts",
    "./codec-types": "./src/geography/codec-types.ts",
    "./operation-types": "./src/geography/operation-types.ts",
    "./column-types": "./src/geography/column-types.ts",
    "./control": "./src/geography/control.ts",
    "./runtime": "./src/geography/runtime.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "contract:emit": "prisma contract emit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "test": "node --test --test-concurrency=1 test/*.unit.test.ts",
    "test:integration": "mkdir -p coverage && cd ../.. && node --test --test-concurrency=1 --test-isolation=none --test-timeout=600000 --experimental-test-coverage --test-coverage-include='packages/prisma-geography/src/geography/**/*.ts' --test-coverage-lines=95 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=packages/prisma-geography/coverage/lcov.info 'packages/prisma-geography/test/*.db.test.ts' 'packages/prisma-geography/test/*.unit.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@animichi/test-postgres": "workspace:*",
    "@prisma/cli-engine": "0.3.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "prisma": "8.0.0-rc.13",
    "typescript": "^7.0.2"
  }
}
