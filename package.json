{
  "name": "animichi-cloudflare-worker",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint:oxlint": "pnpm --filter catalog --filter users --filter web run lint:oxlint",
    "test:worker": "pnpm --filter edge-worker test",
    "verify:dependabot": "pnpm run lint:oxlint && pnpm run test:worker && pnpm -r --if-present typecheck && pnpm --filter web build"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "ws": ">=8.21.0",
      "qs": ">=6.15.2",
      "fast-uri": ">=4.1.1",
      "hono": ">=4.12.34",
      "esbuild": ">=0.28.1",
      "@vitest/expect": "4.1.10",
      "@vitest/spy": "4.1.10",
      "uuid": ">=11.1.1",
      "sharp": ">=0.35.3",
      "valibot": ">=1.4.2",
      "brace-expansion": ">=5.0.9",
      "@hono/node-server": ">=2.0.5",
      "minimatch": ">=10.2.6",
      "testcontainers>undici": "8.9.0",
      "miniflare>undici": "7.29.0",
      "jsdom>undici": "7.29.0",
      "@ai-sdk/provider-utils>undici": "7.29.0",
      "tmp": ">=0.2.6",
      "nanoid": "3.3.18"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxlint": "~1.75.0",
    "oxlint-tsgolint": "~7.0.2001",
    "wrangler": "4.114.0"
  }
}
