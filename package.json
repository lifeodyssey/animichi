      "animal-island-ui>react": "^19.2.6",
      "animal-island-ui>react-dom": "^19.2.6",
      "postcss": ">=8.5.10",
      "ws": ">=8.21.0",
      "qs": ">=6.15.2",
      "fast-uri": ">=3.1.2",
      "hono": ">=4.12.16",
      "esbuild": ">=0.28.1",
      "@vitest/expect": "4.1.9",
      "@vitest/spy": "4.1.9"
