{
  "name": "catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Animichi Catalog service — Cloudflare Workers + Hono + oRPC over Postgres/PostGIS",
  "scripts": {
    "build:topology": "tsx scripts/transit/build-topology.ts",
    "dev": "wrangler dev",
    "fetch:n02": "tsx scripts/transit/fetch-n02.ts",
    "test": "npm run test:worker && npm run test:spike",
    "test:worker": "vitest run --config vitest.config.ts --coverage",
    "test:spike": "vitest run --config vitest.spike.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@orpc/openapi": "1.14.8",
    "@orpc/server": "1.14.8",
    "@seichijunrei/contract": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.19",
    "@cloudflare/workers-types": "^4.20251001.0",
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-istanbul": "4.1.9",
    "eslint": "^10.5.0",
    "pg": "^8.16.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.103.0"
  }
}
