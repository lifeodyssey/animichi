{
  "name": "catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Animichi Catalog service \u2014 Cloudflare Workers + Hono + oRPC over Postgres/PostGIS",
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "tsx scripts/oxlint/check-no-inline-config.ts && tsx scripts/check-worker-entry-exports.ts && oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:worker",
    "build:topology": "tsx scripts/transit/build-topology.ts",
    "dev": "wrangler dev",
    "fetch:n02": "tsx scripts/transit/fetch-n02.ts",
    "test:smoke": "tsx scripts/startup-smoke.ts",
    "test:worker": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@animichi/contract": "workspace:*",
    "@animichi/pi-session-neon": "workspace:*",
    "@animichi/prisma-geography": "workspace:*",
    "@neondatabase/serverless": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@prisma/orm-postgres": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@animichi/test-postgres": "workspace:*",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "miniflare": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
