{
  "name": "catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Animichi Catalog service — Cloudflare Workers + Hono + oRPC over Postgres/PostGIS",
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "tsx scripts/oxlint/check-no-inline-config.ts && tsx scripts/check-worker-entry-exports.ts && oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:worker",
    "build:topology": "tsx scripts/transit/build-topology.ts",
    "dev": "wrangler dev",
    "fetch:n02": "tsx scripts/transit/fetch-n02.ts",
    "test:smoke": "tsx scripts/startup-smoke.ts",
    "test:worker": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@orpc/openapi": "1.14.10",
    "@orpc/server": "1.14.10",
    "@animichi/contract": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@animichi/test-postgres": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "pg": "^8.22.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  }
}
