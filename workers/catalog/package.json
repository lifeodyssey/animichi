{
  "name": "catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Animichi Catalog service — Cloudflare Workers + Hono + oRPC over Postgres/PostGIS",
  "scripts": {
    "build:topology": "tsx scripts/transit/build-topology.ts",
    "dev": "wrangler dev",
    "fetch:n02": "tsx scripts/transit/fetch-n02.ts",
    "lint:oxlint": "tsx scripts/oxlint/check-no-inline-config.ts && oxlint --type-aware --deny-warnings .",
    "test": "npm run test:worker && npm run test:spike",
    "test:worker": "vitest run --config vitest.config.ts --coverage",
    "test:spike": "vitest run --config vitest.spike.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@orpc/openapi": "1.14.8",
    "@orpc/server": "1.14.8",
    "@seichijunrei/contract": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-istanbul": "4.1.10",
    "pg": "^8.22.0",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
