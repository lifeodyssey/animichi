{
  "name": "users",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Animichi Users service \u2014 user-domain routes over Neon (Hono + oRPC)",
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:worker",
    "dev": "wrangler dev",
    "test:worker": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@animichi/contract": "workspace:*",
    "@neondatabase/serverless": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
