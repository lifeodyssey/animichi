{
  "name": "users",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Animichi Users service \u2014 user-domain routes over Neon (Hono + oRPC)",
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:worker",
    "dev": "wrangler dev",
    "test:worker": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@animichi/contract": "workspace:*",
    "@animichi/pi-session-neon": "workspace:*",
    "@animichi/prisma-geography": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@prisma/orm-family-sql": "8.0.0-rc.9",
    "@prisma/orm-postgres": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@animichi/test-postgres": "workspace:*",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
