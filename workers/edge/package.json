{
  "type": "module",
  "name": "edge-worker",
  "private": true,
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:node && pnpm run test:chat-answer-part && pnpm run test:bundle-smoke && pnpm run test:ratelimit-namespace",
    "test:node": "node --experimental-test-module-mocks --import tsx --test \"test/*.test.ts\"",
    "test:chat-answer-part": "pnpm --filter @animichi/contract exec vitest run test/chat-answer-part.test.ts",
    "test:bundle-smoke": "node --test \"bundle-smoke/*.test.ts\"",
    "test:ratelimit-namespace": "bash scripts/check-edge-ratelimit-namespace.test.sh && bash scripts/check-edge-ratelimit-namespace.sh",
    "test:catalog-api": "NODE_USE_ENV_PROXY=1 node --test \"api-test/*.test.ts\"",
    "test:agent-db": "node --import tsx --test --test-isolation=none --test-concurrency=1 \"agent-db-test/*.test.ts\"",
    "test:native-admission": "node --test --test-isolation=none --test-concurrency=1 \"admission-test/*.test.ts\"",
    "test:selection": "node --import tsx --test --test-isolation=none --test-concurrency=1 \"selection-test/*.test.ts\"",
    "test:integration": "pnpm run test:agent-db && pnpm run test:native-admission && pnpm run test:selection && pnpm run test:native-host",
    "test:native-host": "node --import tsx --test --test-isolation=none --test-concurrency=1 \"host-integration-test/*.test.ts\"",
    "test:native-browser": "node --import tsx --test --test-isolation=none --test-concurrency=1 \"host-integration-test/*.browser.ts\""
  },
  "dependencies": {
    "@animichi/agent": "workspace:*",
    "@animichi/contract": "workspace:*",
    "@animichi/pi-session-neon": "workspace:*",
    "@cloudflare/containers": "^0.3.7",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "agents": "0.22.0",
    "ai": "7.0.77",
    "hono": "^4.13.7",
    "jose": "^6.2.4",
    "typebox": "1.3.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@animichi/test-postgres": "workspace:*",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@earendil-works/chord": "0.85.1",
    "@types/pg": "^8.20.0",
    "esbuild": "0.28.1",
    "miniflare": "4.20260722.0",
    "pg": "^8.22.0",
    "pi-agent-core-smoke": "npm:@earendil-works/pi-agent-core@0.85.1",
    "pi-ai-smoke": "npm:@earendil-works/pi-ai@0.85.1",
    "smol-toml": "1.7.1"
  }
}
