{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "ES2024.Promise"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test-support/**/*.ts",
    "api-test/**/*.ts",
    "bundle-smoke/**/*.ts",
    "agent-db-test/**/*.ts",
    "admission-test/**/*.ts",
    "host-integration-test/**/*.ts",
    "selection-test/**/*.ts"
  ]
}
