{
  "name": "migrator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Animichi migrator \u2014 GitHub-OIDC-gated bounded migration apply",
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "wrangler dev",
    "test:worker": "vitest run --coverage"
  },
  "dependencies": {
    "@animichi/contract": "workspace:*",
    "@animichi/pi-session-neon": "workspace:*",
    "@animichi/prisma-geography": "workspace:*",
    "@neondatabase/serverless": "catalog:",
    "@prisma/orm-postgres": "catalog:",
    "@prisma/orm-toolchain": "8.0.0-rc.9",
    "hono": "catalog:",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@animichi/test-postgres": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "esbuild": "catalog:",
    "miniflare": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
