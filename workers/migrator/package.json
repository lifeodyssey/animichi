{
  "name": "migrator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Animichi migrator — GitHub-OIDC-gated bounded migration apply",
  "scripts": {
    "lint": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "wrangler dev",
    "test:worker": "vitest run --coverage"
  },
  "dependencies": {
    "@animichi/contract": "workspace:*",
    "@animichi/pi-session-neon": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "@prisma/orm-toolchain": "8.0.0-rc.9",
    "hono": ">=4.13.7",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@animichi/test-postgres": "workspace:*",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "esbuild": "0.28.1",
    "miniflare": "4.20260722.0",
    "pg": "^8.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.114.0"
  }
}
