{
  "schema_version": "ruleset-cutover/v3",
  "repository": "lifeodyssey/animichi",
  "ruleset_id": 19974534,
  "required_checks": ["CI / verify", "Review Gate"],
  "producer_jobs": {
    "CI / verify": {
      "workflow": ".github/workflows/pr-verification.yml",
      "job_id": "aggregate",
      "name": "CI / verify",
      "type": "check_run",
      "identity_fields": ["id", "path", "event", "head_sha", "head_branch"],
      "events_by_head": {
        "pull_request": "pull_request",
        "merge_group": "merge_group"
      }
    },
    "Review Gate": {
      "workflow": ".github/workflows/review-gate.yml",
      "job_id": "refresh",
      "name": "Refresh trusted head-bound decision",
      "type": "commit_status",
      "context": "Review Gate",
      "integration_id": 15368,
      "identity_fields": ["id", "path", "event", "head_sha", "head_branch"],
      "trusted_branch": "repository.default_branch",
      "pull_request_events": [
        "pull_request_target",
        "pull_request_review",
        "pull_request_review_comment",
        "issue_comment",
        "workflow_run"
      ],
      "merge_group_event": "workflow_run"
    }
  },
  "canary_contract": {
    "schema_version": "ruleset-canary/v3",
    "capture_source": "github_api",
    "content_addressed": true,
    "maximum_age_seconds": 86400,
    "required_heads": ["pull_request", "merge_group"],
    "status_binding": "both exact contexts must be success on their recorded head SHA",
    "producer_binding": "check/status URLs resolve to successful Actions runs with the declared run id, path, event, branch, and head",
    "apply_time_revalidation": {
      "required": true,
      "before": "ruleset_put",
      "comparison": "exact_except_observed_at",
      "refreshes": [
        "pull_request.current_head",
        "merge_group.ci_run_and_head",
        "CI / verify.check_run",
        "Review Gate.classic_status",
        "producer_workflow_runs"
      ]
    }
  },
  "atomic_put": {
    "replace_required_status_checks": true,
    "review_gate_integration_id": 15368,
    "required_review_thread_resolution": true,
    "remove_rule_types": ["code_quality", "code_coverage"],
    "preserve_all_other_rules": true,
    "actions_settings": "not_requested"
  },
  "live_cutover": {
    "status": "pending-content-addressed-canary-and-atomic-put",
    "recovery_artifact": "ruleset-before.json",
    "canary_artifact": "ruleset-canary.json",
    "result_artifact": "ruleset-after.json"
  }
}
