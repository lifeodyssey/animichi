{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "ignorePatterns": [
    "node_modules/**",
    "test-results/**",
    "playwright-report/**",
    ".auth/**",
    "generated/**",
    "agent-discovered/**",
    "visual/report/**",
    "visual/canonical/**"
  ],
  "options": {
    "reportUnusedDisableDirectives": "error"
  }
}
