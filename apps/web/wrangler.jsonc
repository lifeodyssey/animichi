{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animichi-web",
  "main": ".output/server/index.mjs",
  // Main CD promotes Nitro's prebuilt output with `--no-bundle`; Wrangler only
  // uploads JavaScript chunks that match an explicit module rule in that mode.
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Wrangler's esbuild pass defaults to keepNames, which rewrites functions as `__name(fn, "…")`.
  // seroval serialises its SSR stream helpers with Function.prototype.toString(), so those wrappers
  // land in the inline `$tsr-stream-barrier` script where `__name` does not exist — the resulting
  // ReferenceError aborts hydration and blanks every route (issue #426).
  "keep_names": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  // `vars` is non-inheritable: each env block must declare APP_ENV itself. The noindex
  // Nitro plugin (src/server/noindex-plugin.ts) sends X-Robots-Tag on every response
  // unless APP_ENV === "production"; tests/unit/wrangler-app-env.test.ts guards this.
  //
  // The top level needs APP_ENV too, and it must say "production". Both review seats
  // found this independently, and one reproduced it: the top-level `name` above is
  // `animichi-web`, which is the SAME Worker as `env.production.name`. A `wrangler
  // deploy` with no `--env` therefore publishes to production — and with no top-level
  // APP_ENV the plugin's fail-safe would fire and silently serve `noindex` on the live
  // site. CD always passes `--env` and the block-local-deploy hook stops manual
  // deploys, so this is fenced rather than reachable; but the fence is the only thing
  // standing between a redundant deploy and a deindexed production site, so the config
  // states the truth instead of leaning on it.
  "vars": { "APP_ENV": "production" },
  // The top level IS the production Worker (`name` = `animichi-web`, the same
  // Worker as `env.production`), so its subdomain posture is pinned here too
  // (#1524): wrangler resolves an unset `workers_dev` to
  // `routes.length === 0` (wrangler 4.132.0, cli.js `getSubdomainValues`) and
  // this config declares no routes, so an omitted key would OPEN
  // `animichi-web.<subdomain>.workers.dev` on the next deploy. Measured
  // 2026-09-21 before the pin: the host answered 404 with a body byte-identical
  // both to a never-registered host and to a deployed Worker whose subdomain is
  // off (`error code: 1042` in all three cases), so the measurement shows the
  // host is closed and not why. Nothing in this config guaranteed it.
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "animichi-web-staging",
      // #541 step 6 turned the workers.dev host off because it is not on the
      // zone and so bypassed the WAF gate that used to guard staging. #1369
      // replaced that gate with a Cloudflare Access application, which is not a
      // zone feature: it covers `staging.animichi.com` and this worker's
      // `*.workers.dev` hostname alike (`infra/src/staging-access.ts`), so the
      // host below is behind the same login and the same service token as the
      // Custom Domain. `preview_urls` stays off — a per-version preview URL is
      // a hostname nobody added to that application, so it would be the bypass
      // all over again.
      // Main-only CD promotes the one built artifact with this explicit
      // environment block; it no longer rewrites anything inside it.
      // workers_dev on for STAGING ONLY (owner 2026-08-27, mirrors the edge worker):
      // the CD smoke probes the SSR shell here because the zone front door
      // bot-challenges GitHub-runner IPs. Production stays closed.
      "workers_dev": true,
      "preview_urls": false,
      // Public staging RUNTIME_CONFIG is committed: Cloudflare Builds never
      // received the GitHub environment build variables, and an empty inject
      // overwrote the Worker binding (login showed "Sign-in isn't configured").
      // #1364 deleted the injector outright — this block is now the only source.
      "vars": {
        "APP_ENV": "staging",
        "RUNTIME_CONFIG": "{\"schemaVersion\":1,\"api\":{},\"neonAuthBaseUrl\":\"https://ep-broad-frost-aopp3uqq.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth\",\"turnstileSiteKey\":\"0x4AAAAAAD-SYZJEDljOH-SB\",\"showcaseMode\":\"false\",\"featureFlags\":{}}"
      }
    },
    "production": {
      "name": "animichi-web",
      // Subdomain posture pinned explicitly (#1524), for the same reason as
      // the top level above: no routes are declared here, so wrangler's
      // `routes.length === 0` default would open the workers.dev host if the
      // key were omitted. `preview_urls = false` keeps the per-version
      // preview URLs — hostnames nobody added to any Access application —
      // closed as well.
      "workers_dev": false,
      "preview_urls": false,
      // Public production RUNTIME_CONFIG, committed for the same reason as
      // staging's: CD builds the web output ONCE and promotes the same bytes to
      // both environments, so nothing environment-varying may exist at build
      // time (spec §七 #18; the build-variable injector was deleted in #1364).
      //
      // `neonAuthBaseUrl` and `turnstileSiteKey` are deliberately absent, not
      // forgotten. Both are optional in the schema
      // (src/lib/runtime-config/runtime-config.ts) and fail closed when unset —
      // sign-in reports itself unconfigured rather than pointing at another
      // environment's identity provider. Production's Neon Auth branch is not
      // provisioned (the edge keeps NEON_AUTH_JWKS_URL unset for the same
      // reason, AUTH-2 #950, workers/edge/wrangler.toml `[env.production.vars]`)
      // and no production Turnstile site key exists: `gh variable list --env
      // production` was empty on 2026-09-06, which is also why the deleted
      // injector — it required a Neon Auth base URL — could not have published
      // this Worker. Add each value here when its environment is provisioned.
      "vars": {
        "APP_ENV": "production",
        "RUNTIME_CONFIG": "{\"schemaVersion\":1,\"api\":{},\"showcaseMode\":\"false\",\"featureFlags\":{}}"
      }
    }
  }
}
