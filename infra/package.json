{
  "name": "infra",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && pnpm run typecheck:database-access",
    "typecheck:database-access": "bash database-access/typecheck.sh",
    "test": "node --test topology-*.test.ts && pnpm run test:neon-auth-parity && pnpm run test:program-load",
    "test:neon-auth-parity": "pnpm --filter @animichi/contract exec vitest run test/neon-auth.test.ts",
    "test:program-load": "bash ../scripts/local-gates/infra-check.sh"
  },
  "dependencies": {
    "@pulumi/cloudflare": "^6.24.0",
    "@pulumi/pulumi": "^3.277.0",
    "@pulumi/random": "^4.21.6",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "neonctl": "catalog:",
    "smol-toml": "catalog:",
    "typescript": "catalog:"
  }
}
