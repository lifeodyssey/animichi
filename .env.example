# Animichi — Environment Variables
# Copy to .env and fill in your values.
# Every name here has a source consumer; the Python-era tuning and provider
# names that only the deleted agent read left with the Python tree (#1607,
# issue #1750). The eval lane's optional ambient controls (`LOGFIRE_TOKEN`,
# `OPENCODE_API_KEY`) are documented in `packages/eval/NATIVE.md`.

# ============================================================
# REQUIRED
# ============================================================

# Agent-domain Postgres — the Neon agent_svc role DSN (#912). The auth plane is
# Neon Auth now (AUTH-2 #950). The legacy SUPABASE_DB_URL compatibility name is
# gone (issue #1000). Read by the native agent tier
# (workers/edge/src/agent/host/native-bootstrap.ts).
AGENT_SVC_DATABASE_URL=postgresql://agent_svc:password@neon-branch-endpoint:5432/neondb?sslmode=require

# ============================================================
# OPTIONAL — Neon Auth (login + local dev, AUTH-2 #950)
# ============================================================

# Better Auth origin of the branch running Neon Auth, e.g.
# https://<branch>.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth
# Used by scripts/local-login.sh (make local-login) when apps/web/.env does not
# carry VITE_NEON_AUTH_BASE_URL, and by the E2E live-login spec
# (e2e/helpers/neon-auth-origin.ts).
NEON_AUTH_BASE_URL=

# Branch DB connection string for the local-login token read (same branch that
# runs Neon Auth — the magic-link token lives in its neon_auth.verification).
# Read by scripts/local-login.sh.
NEON_DATABASE_URL=

# QA login (Path A of docs/ops/auth-migration-neon.md §4) — E2E live-login spec
# (e2e/live-login-env.test.ts) + database-access IaC declaration. The password
# is a secret; never commit the real value here.
QA_NEON_USER_EMAIL=
QA_NEON_USER_PASSWORD=

# ============================================================
# OPTIONAL — Model providers
# ============================================================

# The native agent tier's model credential (workers/edge binding; the eval
# native runner reads it as an ambient control). The runtime is MiMo-only
# (owner decision 2026-09-15): no DeepSeek key is provisioned, bound or
# forwarded.
MIMO_API_KEY=

# ============================================================
# OPTIONAL — Cloudflare Turnstile (edge bot protection, S1.9)
# ============================================================

# Server-side siteverify secret (35 chars). In production this is a Worker
# secret binding read as `env.TURNSTILE_SECRET` — there is no process.env in
# Workers. The public 24-char SITE key lives in apps/web/.env.example.
TURNSTILE_SECRET=
