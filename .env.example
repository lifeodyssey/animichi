# Animichi — Environment Variables
# Copy to .env and fill in your values.

# ============================================================
# REQUIRED
# ============================================================

# Agent-domain Postgres — the Neon agent_svc role DSN (asyncpg, #912). The
# auth plane is Neon Auth now (AUTH-2 #950). The legacy SUPABASE_DB_URL
# compatibility name is gone (issue #1000).
AGENT_SVC_DATABASE_URL=postgresql://agent_svc:password@neon-branch-endpoint:5432/neondb?sslmode=require

# ============================================================
# OPTIONAL — Neon Auth (login + local dev, AUTH-2 #950)
# ============================================================

# Better Auth origin of the branch running Neon Auth, e.g.
# https://<branch>.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth
# Used by scripts/local-login.sh (make local-login) when apps/web/.env does not
# carry VITE_NEON_AUTH_BASE_URL, and by the E2E live-login spec.
NEON_AUTH_BASE_URL=

# Branch DB connection string for the local-login token read (same branch that
# runs Neon Auth — the magic-link token lives in its neon_auth.verification).
NEON_DATABASE_URL=

# QA login (Path A of docs/ops/auth-migration-neon.md §4) — E2E live-login spec
# + database-access IaC declaration. The password is a secret; never commit the
# real value here.
QA_NEON_USER_EMAIL=
QA_NEON_USER_PASSWORD=

# LLM providers — MiMo primary; keep the dormant DeepSeek key provisioned
MIMO_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_AGENT_MODEL=openai:mimo-v2.5@https://api.xiaomimimo.com/v1
# Empty = MiMo-only. DeepSeek fallback is disabled pending an account recharge.
# Re-enable with: FALLBACK_AGENT_MODEL=deepseek:deepseek-v4-flash
FALLBACK_AGENT_MODEL=
OPENAI_COMPAT_BASE_URL=https://api.xiaomimimo.com/v1

# Optional: custom OpenAI-compatible providers outside MiMo/DeepSeek
OPENAI_COMPAT_API_KEY=

# ============================================================
# OPTIONAL — Application tuning
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false
MAX_RETRIES=3
TIMEOUT_SECONDS=30
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8080

CACHE_TTL_SECONDS=3600
USE_CACHE=true

RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD_SECONDS=60

# ============================================================
# OPTIONAL — Observability (logfire)
# ============================================================

# Tracing + metrics are exported to Logfire only when a token is set.
# LOGFIRE_TOKEN=

# ============================================================
# OPTIONAL — Cloudflare Turnstile (edge bot protection, S1.9)
# ============================================================

# Server-side siteverify secret (35 chars). In production this is a Worker
# secret binding read as `env.TURNSTILE_SECRET` — there is no process.env in
# Workers. The public 24-char SITE key lives in apps/web/.env.example.
TURNSTILE_SECRET=
